  - m_Id: 64380276801536
    m_Localized: "\uC815\uBE44 \uC2DC\uAC04 \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 64885518467072
    m_Localized: "\uAC74\uBB3C \uC124\uCE58\uB97C \uCDE8\uC18C\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 65301018804224
    m_Localized: "{0}\uB85C \uBB34\uAE30\uB97C \uAD50\uCCB4\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7146448972180095195
  - m_Id: 66973292003328
    m_Localized: "\uB808\uBCA8\uC5C5!!"
    m_Metadata:
      m_Items: []
  - m_Id: 67366185041920
    m_Localized: "\uBD88\uAD74 \uBC1C\uB3D9!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 67791646851072
    m_Localized: "\uC81C\uC791\uC774 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 68308678705152
    m_Localized: "\uC790\uC6D0\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 69342960517120
    m_Localized: "\uD574\uB2F9 \uC790\uC6D0\uC740 \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 69834885267456
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC\uAC00 \uAF49 \uCC3C\uC2B5\uB2C8\uB2E4!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 70841597919232
    m_Localized: "\uD574\uB2F9 \uD30C\uCE20\uB97C \uBCF4\uC720\uD558\uACE0 \uC788\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4!!"
    m_Metadata:
      m_Items: []
  - m_Id: 71625492365312
    m_Localized: "\uD30C\uCE20\uAC00 \uC7A5\uCC29\uB418\uC5B4 \uC788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4!!"
    m_Metadata:
      m_Items: []
  - m_Id: 72021556297728
    m_Localized: "\uC9C0\uB8B0\uB294 \uD55C \uBC88\uC5D0 {maxCount + TechTreeUnlock.additionalMineCount}\uAC1C
      \uAE4C\uC9C0\uB9CC \uC124\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 72729860997120
